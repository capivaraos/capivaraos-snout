# Logs e artefatos de build do livemedia-creator / anaconda (gerados a cada
# build, nao fazem parte do codigo-fonte)
anaconda/
*.log

# RPM gerado localmente (ver rpm/build-rpm.sh) e repositorio local de build
*.rpm

# CHAVE PRIVADA de assinatura do repo — NUNCA versionar (ver keys/README.md).
# A pública (keys/RPM-GPG-KEY-capivaraos) É versionada de propósito.
*PRIVATE*
keys/*secret*
keys/*.sec.asc

# Repositório publicado localmente pelo publish-repo.sh (assinado; local só).
/out/
